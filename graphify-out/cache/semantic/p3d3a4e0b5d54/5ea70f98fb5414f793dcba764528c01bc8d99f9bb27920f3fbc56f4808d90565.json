{"nodes": [{"id": "marketing_plan_10_clients", "label": "Plan T\u00e1ctico para Conseguir los Primeros 10 Clientes", "file_type": "document", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L1-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_early_adopter_acquisition", "label": "Early Adopters acquisition via direct sales and close network", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-week action plan to land the first users through direct sales and leverage of nearby networks."}, {"id": "marketing_plan_10_clients_product", "label": "Product: client and project management tool (Asana/Jira alternative)", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L26,L34,L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_pitch_value_proposition", "label": "Fase 1: Pitch (value proposition)", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L5-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_target_audience", "label": "Target audience: small digital agencies, dev/design freelancers, consultants", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_unlimited_users_hook", "label": "Hook: unlimited users for a fixed price", "file_type": "rationale", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-user pricing in expensive tools such as Asana and Jira is the pain point. A flat price with unlimited users is the main differentiator."}, {"id": "marketing_plan_10_clients_irresistible_offer", "label": "Irresistible offer for the first 10 customers", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L11-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_concierge_setup", "label": "Configuraci\u00f3n Concierge (founder-led migration and setup)", "file_type": "rationale", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L12,L49-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data migration is the number one barrier to switching software. Migrating data, logos and clients for the customer removes that friction and justifies trying the service. Presented as the founder's competitive advantage."}, {"id": "marketing_plan_10_clients_founding_customer_incentive", "label": "Incentive: 50% lifetime discount or 3 free months of Business", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Granted in exchange for detailed feedback."}, {"id": "marketing_plan_10_clients_week1_close_network", "label": "Semana 1: Red cercana y venta directa", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L17-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objective: get validation and the first 3 test users."}, {"id": "marketing_plan_10_clients_friends_beta_test", "label": "D\u00eda 1-2: Beta test con amigos", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L21-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "List 20 contacts (ex-colleagues, freelancer friends, SMB owners) and ask for advice instead of selling. The script offers a free Business account for 6 months in exchange for honest feedback."}, {"id": "marketing_plan_10_clients_linkedin_sniper", "label": "D\u00eda 3-5: LinkedIn Sniper", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L28-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search agency owners, founders, freelance developers and web designers in the sender's own city or country to build trust immediately. Send 10 messages a day offering VIP access to 5 agencies and a 5-minute demo in exchange for feedback."}, {"id": "marketing_plan_10_clients_week2_communities_niche", "label": "Semana 2: Comunidades y nicho", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L38-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objective: widen reach to qualified strangers."}, {"id": "marketing_plan_10_clients_reddit_facebook_groups", "label": "D\u00eda 6-8: Reddit y grupos de Facebook", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L42-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Join freelancer, graphic designer and programmer groups and tell the founder story (storytelling) instead of pure spam. Sample post: tired of paying hundreds of dollars for Jira just to let clients see progress, so built own tool with unlimited users, offered free for feedback."}, {"id": "marketing_plan_10_clients_concierge_sales_tactic", "label": "D\u00eda 9-10: Venta Concierge (migrate Excel or Trello data by next day)", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L49-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_launch_pricing_strategy", "label": "Estrategia de precios para el lanzamiento", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L58-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_free_starter_tier", "label": "Gratis (Starter) tier: target 50 users", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use free users to find bugs and fill the database. Ask for testimonials in exchange for extended limits."}, {"id": "marketing_plan_10_clients_paid_business_tier", "label": "Pago (Business) tier: target 10 clients", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paying clients get VIP WhatsApp support straight from the founder. Naming differs across sources: this plan and PricingPage.tsx call the paid tier Business, while useSubscription.ts and the landing Pricing.tsx call it Pro."}, {"id": "marketing_plan_10_clients_vip_whatsapp_founder_support", "label": "VIP support via WhatsApp directly with the founder", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personalized attention from a founder who is one message away is worth more than the software."}, {"id": "marketing_plan_10_clients_feedback_for_access_exchange", "label": "Free or VIP access in exchange for feedback and testimonials", "file_type": "rationale", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L13,L26,L34,L47,L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recurring pattern: with an unproven product, free or discounted access is traded for honest feedback, detailed input and testimonials. This gives validation, bug discovery and social proof."}, {"id": "marketing_plan_10_clients_asana", "label": "Asana", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L10,L34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_jira", "label": "Jira", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L10,L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_plan_10_clients_trello", "label": "Trello", "file_type": "concept", "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "marketing_plan_10_clients", "target": "marketing_plan_10_clients_early_adopter_acquisition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L3", "weight": 1.0}, {"source": "marketing_plan_10_clients", "target": "marketing_plan_10_clients_pitch_value_proposition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L5", "weight": 1.0}, {"source": "marketing_plan_10_clients", "target": "marketing_plan_10_clients_week1_close_network", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L17", "weight": 1.0}, {"source": "marketing_plan_10_clients", "target": "marketing_plan_10_clients_week2_communities_niche", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_PLAN_10_CLIENTS.md", "source_location": "L38", "weight": 1.0}, {"source": "marketing_plan_10_clients", "target": "marketing_plan_10_clients_launch_pricing_strategy", 