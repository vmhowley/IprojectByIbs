{"nodes": [{"id": "src_public_logocomplete", "label": "LogoComplete.webp", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Horizontal ibPulse logo lockup on white: orange rounded-square pulse icon plus charcoal wordmark. Same composition as Logoibpulse1.webp (red and black). No source file imports it; the app imports Logoibpulse.webp. A placeholder comment in SplashScreen.tsx asks for a 'new logo', so this may be a pending replacement (unverified)."}, {"id": "src_public_logocomplete_pulse_icon_orange_rounded_square", "label": "Pulse icon (orange rounded square)", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Square icon with a white ECG line reads as a live pulse on project health, matching the name ibPulse and the tracker purpose. Inferred from name and motif; no source file states it."}, {"id": "src_public_logocomplete_ecg_heartbeat_line_white", "label": "ECG heartbeat line (white)", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White heartbeat waveform runs edge to edge along the icon baseline, with a flat lead-in and lead-out around the spikes. A similar ECG-shaped SVG polyline drives the animated loader in SplashScreen.tsx."}, {"id": "src_public_logocomplete_ibpulse_wordmark_charcoal", "label": "ibPulse wordmark (charcoal)", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixed-case 'ib' + 'P' + 'ulse' in a bold geometric sans, dark charcoal. Spells the product name shown in the index.html title ('ibPulse - By IBSYSTEMS.SRL') and in logo alt text in Footer, the landing Navbar and SplashScreen."}, {"id": "src_public_logocomplete_square_i_dot_orange", "label": "Square i-dot (orange)", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The round dot of the 'i' is replaced by a rounded square at ascender height, echoing the icon's rounded-square shape to tie wordmark and icon together. The same device appears in Logoibpulse.webp and Logoibpulse1.webp (red), so it looks like a brand-wide invariant."}, {"id": "src_public_logocomplete_orange_and_charcoal_palette", "label": "Orange and charcoal palette", "file_type": "image", "source_file": "src/public/LogoComplete.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orange accent with dark charcoal type on white; a recolor of the red and black scheme in Logoibpulse1.webp. Why this palette exists (alternate brand option or abandoned variant) is not documented."}], "edges": [{"source": "src_public_logocomplete", "target": "src_public_logocomplete_pulse_icon_orange_rounded_square", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/public/LogoComplete.webp", "source_location": null, "weight": 1.0}, {"source": "src_public_logocomplete", "target": "src_public_logocomplete_ibpulse_wordmark_charcoal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/public/LogoComplete.webp", "source_location": null, "weight": 1.0}, {"source": "src_public_logocomplete", "target": "src_public_logocomplete_orange_and_charcoal_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/public/LogoComplete.webp", "source_location": null, "weight": 1.0}, {"source": "src_public_logocomplete_pulse_icon_orange_rounded_squ